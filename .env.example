# ---- required ----
# PostgreSQL connection string (Neon, Supabase, Railway or your own server)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/amigo?sslmode=require"
# Public address of the site, no trailing slash
APP_URL="https://amigo.cash"
# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=""
# exactly 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=""
# protects /api/cron:  openssl rand -hex 24
CRON_SECRET=""

# ---- proxies ----
# how many proxies sit in front of the app (1 for Vercel / Railway / Fly)
TRUSTED_PROXY_HOPS="1"
# "true" only if the origin accepts traffic from Cloudflare alone
TRUST_CLOUDFLARE="false"

# ---- optional integrations (features switch off when empty) ----
RESEND_API_KEY=""
EMAIL_FROM="Amigo Cash <support@amigo.cash>"
IPQS_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
