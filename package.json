{
  "name": "amigo-cash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "admin:make": "tsx scripts/make-admin.ts",
    "demo:data": "tsx scripts/demo-data.ts",
    "check": "npm run typecheck && npm run lint && npm run i18n:check && npm test",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "2fa:reset": "tsx scripts/reset-2fa.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
